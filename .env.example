# Copy this file to .env.local and fill in what you need. All values are optional locally.

# Your live domain (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=ToolHub
NEXT_PUBLIC_CONTACT_EMAIL=ahmadsaleemawan890@gmail.com

# Google AdSense (after approval)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Developer dashboard (/developer). Required in production.
DEVELOPER_PASSWORD=
# Optional secret word that opens /developer when typed anywhere on the site
NEXT_PUBLIC_DEV_SHORTCUT=

# Analytics storage: Upstash Redis (added automatically by Vercel's Upstash integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional extra secret for hashing anonymous visitor IDs
ANALYTICS_SALT=
